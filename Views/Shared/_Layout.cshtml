@using Microsoft.EntityFrameworkCore
@using TodoMaster.Data
@inject AppDbContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - TodoMaster
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TodoMaster.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Navigation -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand"
                   asp-controller="Todo"
                   asp-action="Index">
                    TodoMaster
                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Todos -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Todo"
                               asp-action="Index">

                                Todos

                                <span class="badge bg-primary">
                                    @await DbContext.Todos.CountAsync()
                                </span>

                            </a>

                        </li>
                        <li class="nav-item">
    <a class="nav-link"
       asp-controller="Todo"
       asp-action="Dashboard">
        <i class="bi bi-speedometer2 me-1"></i>
        Dashboard
    </a>
</li>

                        <!-- Categories -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Category"
                               asp-action="Index">
                                Categories
                            </a>

                        </li>

                        <!-- Tags -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Tag"
                               asp-action="Index">
                                Tags
                            </a>

                        </li>

                    </ul>

                    <!-- Create Todo -->
                    <div class="d-flex">

                        <a asp-controller="Todo"
                           asp-action="Create"
                           class="btn btn-primary">
                            + New Todo
                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- Main Content -->
    <main role="main"
          class="pb-3">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; @DateTime.Now.Year - TodoMaster

        </div>

    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>