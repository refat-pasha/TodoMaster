@model IEnumerable<TodoMaster.Models.Tag>

@{
    ViewData["Title"] = "Tags";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Tags</h1>
            <p class="text-muted mb-0">
                Manage tags for your todos.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Tag
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-tags display-4 text-muted"></i>

                <h4 class="mt-3">No tags yet</h4>

                <p class="text-muted">
                    Create your first tag to organize your todos.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Create Tag
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model)
                    {
                        <div class="badge bg-light text-dark border p-2">

                            <i class="bi bi-tag"></i>
                            @tag.Name

                            <a asp-action="Edit"
                               asp-route-id="@tag.Id"
                               class="text-primary ms-2"
                               title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@tag.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this tag?');">

                                <button type="submit"
                                        class="btn btn-link text-danger p-0 ms-1"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </form>

                        </div>
                    }

                </div>

            </div>
        </div>
    }

</div>