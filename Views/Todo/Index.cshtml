@model TodoMaster.ViewModels.TodoIndexViewModel

@{
    ViewData["Title"] = "Todos";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">My Todos</h1>
            <p class="text-muted mb-0">
                Manage your tasks and stay organized.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Todo
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Todos</div>
                    <div class="fs-3 fw-bold">
                        @Model.TotalTodos
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Completed</div>
                    <div class="fs-3 fw-bold text-success">
                        @Model.CompletedTodos
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Pending</div>
                    <div class="fs-3 fw-bold text-warning">
                        @Model.PendingTodos
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Overdue</div>
                    <div class="fs-3 fw-bold text-danger">
                        @Model.OverdueTodos
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Search & Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search todos..." />
                    </div>

                    <!-- Status -->
                    <div class="col-md-2">
                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">All</option>

                            <option value="pending"
                                    selected="@(Model.StatusFilter == "pending")">
                                Pending
                            </option>

                            <option value="completed"
                                    selected="@(Model.StatusFilter == "completed")">
                                Completed
                            </option>

                            <option value="overdue"
                                    selected="@(Model.StatusFilter == "overdue")">
                                Overdue
                            </option>

                        </select>
                    </div>

                    <!-- Priority -->
                    <div class="col-md-2">
                        <label class="form-label">
                            Priority
                        </label>

                        <select name="priority"
                                class="form-select">

                            <option value="">All</option>

                            @foreach (var priority in Enum.GetValues<TodoMaster.Models.Priority>())
                            {
                                <option value="@priority"
                                        selected="@(Model.PriorityFilter == priority.ToString())">
                                    @priority
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Category -->
                    <div class="col-md-2">
                        <label class="form-label">
                            Category
                        </label>

                        <select name="categoryId"
                                class="form-select">

                            <option value="">All</option>

                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Value"
                                            selected="@(Model.CategoryFilter?.ToString() == category.Value)">
                                        @category.Text
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <!-- Sort -->
                    <div class="col-md-2">
                        <label class="form-label">
                            Sort
                        </label>

                        <select name="sort"
                                class="form-select">

                            <option value="created_desc"
                                    selected="@(Model.SortOrder == "created_desc")">
                                Newest
                            </option>

                            <option value="created_asc"
                                    selected="@(Model.SortOrder == "created_asc")">
                                Oldest
                            </option>

                            <option value="title_asc"
                                    selected="@(Model.SortOrder == "title_asc")">
                                Title A-Z
                            </option>

                            <option value="title_desc"
                                    selected="@(Model.SortOrder == "title_desc")">
                                Title Z-A
                            </option>

                            <option value="due_asc"
                                    selected="@(Model.SortOrder == "due_asc")">
                                Due Date ↑
                            </option>

                            <option value="due_desc"
                                    selected="@(Model.SortOrder == "due_desc")">
                                Due Date ↓
                            </option>

                            <option value="priority_asc"
                                    selected="@(Model.SortOrder == "priority_asc")">
                                Priority ↑
                            </option>

                            <option value="priority_desc"
                                    selected="@(Model.SortOrder == "priority_desc")">
                                Priority ↓
                            </option>

                        </select>
                    </div>

                </div>

                <div class="mt-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- Todo List -->
    @if (Model.Todos == null || !Model.Todos.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-check2-square fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No todos found
                </h4>

                <p class="text-muted">
                    Create a new todo to get started.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Create Todo
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var todo in Model.Todos)
            {
                <div class="col-12">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <!-- Todo Information -->
                                <div class="flex-grow-1">

                                    <div class="d-flex align-items-center gap-2">

                                        @if (todo.IsCompleted)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                        <span class="badge bg-secondary">
                                            @todo.Priority
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(todo.CategoryName))
                                        {
                                            <span class="badge bg-info text-dark">
                                                @todo.CategoryName
                                            </span>
                                        }

                                    </div>

                                    <h5 class="mt-2 mb-1
                                        @(todo.IsCompleted ? "text-decoration-line-through text-muted" : "")">

                                        @todo.Title

                                    </h5>

                                    @if (!string.IsNullOrWhiteSpace(todo.Description))
                                    {
                                        <p class="text-muted mb-2">
                                            @todo.Description
                                        </p>
                                    }

                                    <div class="small text-muted">

                                        <span>
                                            Created:
                                            @todo.CreatedAt.ToString("dd MMM yyyy")
                                        </span>

                                        @if (todo.DueDate.HasValue)
                                        {
                                            <span class="ms-3">
                                                Due:
                                                @todo.DueDate.Value.ToString("dd MMM yyyy")
                                            </span>
                                        }

                                    </div>

                                    <!-- Tags -->
                                    @if (todo.TagNames != null &&
                                         todo.TagNames.Any())
                                    {
                                        <div class="mt-2">

                                            @foreach (var tag in todo.TagNames)
                                            {
                                                <span class="badge bg-light text-dark border me-1">
                                                    #@tag
                                                </span>
                                            }

                                        </div>
                                    }

                                </div>

                                <!-- Actions -->
                                <div class="d-flex gap-2 ms-3">

                                    <!-- Toggle Complete -->
                                    <form asp-action="ToggleComplete"
                                          asp-route-id="@todo.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                title="Toggle Complete">

                                            @if (todo.IsCompleted)
                                            {
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-lg"></i>
                                            }

                                        </button>

                                    </form>

                                    <!-- Details -->
                                    <a asp-action="Details"
                                       asp-route-id="@todo.Id"
                                       class="btn btn-sm btn-outline-info"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <!-- Edit -->
                                    <a asp-action="Edit"
                                       asp-route-id="@todo.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <!-- Delete -->
                                    <form asp-action="Delete"
                                          asp-route-id="@todo.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this todo?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>