@using TodoMaster.Models
@model TodoMaster.ViewModels.TodoIndexViewModel

@{
    ViewData["Title"] = "My Todos";
}

<div class="container py-4">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="display-6 fw-bold mb-1">
                My Todos
            </h1>

            <p class="text-muted mb-0">
                Manage your tasks and stay organized.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Todo
        </a>

    </div>


    <!-- =========================================================
         TODO STATISTICS
         ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalCount
                            </h3>

                        </div>

                        <div class="fs-2 text-primary">
                            <i class="bi bi-list-task"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending -->
        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Pending
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.PendingCount
                            </h3>

                        </div>

                        <div class="fs-2 text-warning">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->
        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Completed
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.CompletedCount
                            </h3>

                        </div>

                        <div class="fs-2 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Overdue -->
        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Overdue
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.OverdueCount
                            </h3>

                        </div>

                        <div class="fs-2 text-danger">
                            <i class="bi bi-exclamation-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SEARCH & FILTER
         ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by title or description..." />

                    </div>


                    <!-- Status -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status" class="form-select">

                            @if (string.IsNullOrEmpty(ViewBag.Status))
                            {
                                <option value="" selected>
                                    All
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All
                                </option>
                            }


                            @if (ViewBag.Status == "pending")
                            {
                                <option value="pending" selected>
                                    Pending
                                </option>
                            }
                            else
                            {
                                <option value="pending">
                                    Pending
                                </option>
                            }


                            @if (ViewBag.Status == "completed")
                            {
                                <option value="completed" selected>
                                    Completed
                                </option>
                            }
                            else
                            {
                                <option value="completed">
                                    Completed
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Priority -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Priority
                        </label>

                        <select name="priority" class="form-select">

                            @if (ViewBag.Priority == null)
                            {
                                <option value="" selected>
                                    All
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All
                                </option>
                            }


                            @foreach (Priority priority in Enum.GetValues<Priority>())
                            {
                                @if (ViewBag.Priority?.ToString() == priority.ToString())
                                {
                                    <option value="@priority" selected>
                                        @priority
                                    </option>
                                }
                                else
                                {
                                    <option value="@priority">
                                        @priority
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Category -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select name="categoryId" class="form-select">

                            @if (ViewBag.CategoryId == null)
                            {
                                <option value="" selected>
                                    All
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All
                                </option>
                            }


                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var category in ViewBag.Categories)
                                {
                                    if (ViewBag.CategoryId?.ToString() == category.Id.ToString())
                                    {
                                        <option value="@category.Id" selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }
                                }
                            }

                        </select>

                    </div>


                    <!-- Tag -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Tag
                        </label>

                        <select name="tagId" class="form-select">

                            @if (ViewBag.TagId == null)
                            {
                                <option value="" selected>
                                    All
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All
                                </option>
                            }


                            @if (ViewBag.Tags != null)
                            {
                                @foreach (var tag in ViewBag.Tags)
                                {
                                    if (ViewBag.TagId?.ToString() == tag.Id.ToString())
                                    {
                                        <option value="@tag.Id" selected>
                                            @tag.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@tag.Id">
                                            @tag.Name
                                        </option>
                                    }
                                }
                            }

                        </select>

                    </div>


                    <!-- Sort -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Sort By
                        </label>

                        <select name="sort" class="form-select">

                            @if (string.IsNullOrEmpty(ViewBag.Sort))
                            {
                                <option value="" selected>
                                    Newest
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    Newest
                                </option>
                            }


                            @if (ViewBag.Sort == "oldest")
                            {
                                <option value="oldest" selected>
                                    Oldest
                                </option>
                            }
                            else
                            {
                                <option value="oldest">
                                    Oldest
                                </option>
                            }


                            @if (ViewBag.Sort == "dueDate")
                            {
                                <option value="dueDate" selected>
                                    Due Date
                                </option>
                            }
                            else
                            {
                                <option value="dueDate">
                                    Due Date
                                </option>
                            }


                            @if (ViewBag.Sort == "priority")
                            {
                                <option value="priority" selected>
                                    Priority
                                </option>
                            }
                            else
                            {
                                <option value="priority">
                                    Priority
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Buttons -->
                    <div class="col-12 d-flex justify-content-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search"></i>
                            Search

                        </button>


                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         TODO LIST
         ========================================================= -->

    @if (Model.Todos == null || !Model.Todos.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="mb-3">

                    <i class="bi bi-check2-circle display-4 text-muted"></i>

                </div>

                <h4>
                    No todos found
                </h4>

                <p class="text-muted">
                    Try changing your search or filters.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg"></i>
                    Create Your First Todo

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var todo in Model.Todos)
            {
                var isOverdue =
                    !todo.IsCompleted &&
                    todo.DueDate.HasValue &&
                    todo.DueDate.Value.Date < DateTime.Today;


                <div class="col-12">

                    <div class="card shadow-sm border-0
                                @(isOverdue ? "border-start border-4 border-danger" : "")">

                        <div class="card-body">

                            <div class="row align-items-center">


                                <!-- =================================================
                                     COMPLETE / UNCOMPLETE
                                     ================================================= -->

                                <div class="col-auto">

                                    <form asp-action="Complete"
                                          asp-route-id="@todo.Id"
                                          method="post"
                                          class="d-inline">

                                        @if (todo.IsCompleted)
                                        {
                                            <button type="submit"
                                                    class="btn btn-success rounded-circle"
                                                    title="Mark as pending">

                                                <i class="bi bi-check-lg"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-outline-secondary rounded-circle"
                                                    title="Mark as completed">

                                                <i class="bi bi-circle"></i>

                                            </button>
                                        }

                                    </form>

                                </div>


                                <!-- =================================================
                                     TODO INFORMATION
                                     ================================================= -->

                                <div class="col">

                                    <!-- Title -->
                                    @if (todo.IsCompleted)
                                    {
                                        <h5 class="mb-1 text-decoration-line-through text-muted">
                                            @todo.Title
                                        </h5>
                                    }
                                    else
                                    {
                                        <h5 class="mb-1">
                                            @todo.Title
                                        </h5>
                                    }


                                    <!-- Description -->
                                    @if (!string.IsNullOrWhiteSpace(todo.Description))
                                    {
                                        <p class="text-muted mb-2">
                                            @todo.Description
                                        </p>
                                    }


                                    <!-- Metadata -->
                                    <div class="d-flex flex-wrap align-items-center gap-2">


                                        <!-- Priority -->
                                        <span class="badge
                                            @(todo.Priority == "High"
    ? "bg-danger"
    : todo.Priority == "Medium"
        ? "bg-warning text-dark"
        : "bg-secondary")">

                                            @todo.Priority

                                        </span>


                                        <!-- Due Date -->
                                        @if (todo.DueDate.HasValue)
                                        {
                                            @if (isOverdue)
                                            {
                                                <span class="text-danger small fw-semibold">

                                                    <i class="bi bi-exclamation-circle"></i>

                                                    Overdue:
                                                    @todo.DueDate.Value.ToString("dd MMM yyyy")

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">

                                                    <i class="bi bi-calendar-event"></i>

                                                    Due:
                                                    @todo.DueDate.Value.ToString("dd MMM yyyy")

                                                </span>
                                            }
                                        }


                                        <!-- Created Date -->
                                        <span class="text-muted small">

                                            <i class="bi bi-clock"></i>

                                            @todo.CreatedAt.ToString("dd MMM yyyy")

                                        </span>

                                    </div>

                                </div>


                                <!-- =================================================
                                     ACTION BUTTONS
                                     ================================================= -->

                                <div class="col-auto">

                                    <div class="d-flex gap-2">


                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit todo">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete todo">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    <!-- =========================================================
         PAGINATION
         ========================================================= -->

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">

            <nav aria-label="Todo pagination">

                <ul class="pagination">


                    <!-- Previous -->
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-priority="@ViewBag.Priority"
                           asp-route-categoryId="@ViewBag.CategoryId"
                           asp-route-tagId="@ViewBag.TagId"
                           asp-route-sort="@ViewBag.Sort"
                           asp-route-page="@(Model.CurrentPage - 1)">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>


                    <!-- Page Numbers -->
                    @for (int page = 1; page <= Model.TotalPages; page++)
                    {
                        <li class="page-item @(page == Model.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-status="@ViewBag.Status"
                               asp-route-priority="@ViewBag.Priority"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-tagId="@ViewBag.TagId"
                               asp-route-sort="@ViewBag.Sort"
                               asp-route-page="@(page)">

                                @(page)

                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-priority="@ViewBag.Priority"
                           asp-route-categoryId="@ViewBag.CategoryId"
                           asp-route-tagId="@ViewBag.TagId"
                           asp-route-sort="@ViewBag.Sort"
                           asp-route-page="@(Model.CurrentPage + 1)">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>