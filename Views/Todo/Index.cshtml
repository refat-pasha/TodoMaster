@model TodoMaster.ViewModels.TodoIndexViewModel

@{
    ViewData["Title"] = "Todo List";
}

<div class="container mt-4">

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>My Todos</h2>
            <p class="text-muted mb-0">
                Manage your tasks, categories, priorities, and tags.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Create Todo
        </a>

    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Todos</h6>

                    <h3 class="mb-0">
                        @Model.TotalTodos
                    </h3>
                </div>
            </div>
        </div>

        <!-- Completed -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Completed</h6>

                    <h3 class="mb-0 text-success">
                        @Model.CompletedTodos
                    </h3>
                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Pending</h6>

                    <h3 class="mb-0 text-warning">
                        @Model.PendingTodos
                    </h3>
                </div>
            </div>
        </div>

        <!-- Overdue -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Overdue</h6>

                    <h3 class="mb-0 text-danger">
                        @Model.OverdueTodos
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search title or description..." />

                    </div>

                    <!-- Status -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value=""
                                    selected="@(string.IsNullOrEmpty(Model.StatusFilter))">
                                All
                            </option>

                            <option value="pending"
                                    selected="@(Model.StatusFilter == "pending")">
                                Pending
                            </option>

                            <option value="completed"
                                    selected="@(Model.StatusFilter == "completed")">
                                Completed
                            </option>

                            <option value="overdue"
                                    selected="@(Model.StatusFilter == "overdue")">
                                Overdue
                            </option>

                        </select>

                    </div>

                    <!-- Priority -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Priority
                        </label>

                        <select name="priority"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            @foreach (var priority in
                                Enum.GetValues<TodoMaster.Models.Priority>())
                            {
                                <option value="@priority"
                                        selected="@(Model.PriorityFilter == priority.ToString())">
                                    @priority
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Category -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Category
                        </label>

                        <select name="categoryId"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id"
                                        selected="@(Model.CategoryFilter == category.Id)">
                                    @category.Name
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Tag -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Tag
                        </label>

                        <select name="tagId"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            @foreach (var tag in ViewBag.Tags)
                            {
                                <option value="@tag.Id"
                                        selected="@(Model.TagFilter == tag.Id)">
                                    @tag.Name
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Sort -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Sort By
                        </label>

                        <select name="sort"
                                class="form-select">

                            <option value="created_desc"
                                    selected="@(Model.SortOrder == "created_desc")">
                                Newest First
                            </option>

                            <option value="created_asc"
                                    selected="@(Model.SortOrder == "created_asc")">
                                Oldest First
                            </option>

                            <option value="title_asc"
                                    selected="@(Model.SortOrder == "title_asc")">
                                Title A-Z
                            </option>

                            <option value="title_desc"
                                    selected="@(Model.SortOrder == "title_desc")">
                                Title Z-A
                            </option>

                            <option value="due_asc"
                                    selected="@(Model.SortOrder == "due_asc")">
                                Due Date ↑
                            </option>

                            <option value="due_desc"
                                    selected="@(Model.SortOrder == "due_desc")">
                                Due Date ↓
                            </option>

                            <option value="priority_asc"
                                    selected="@(Model.SortOrder == "priority_asc")">
                                Priority Low-High
                            </option>

                            <option value="priority_desc"
                                    selected="@(Model.SortOrder == "priority_desc")">
                                Priority High-Low
                            </option>

                        </select>

                    </div>

                    <!-- Filter Buttons -->
                    <div class="col-md-9 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Apply Filters
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Clear Filters
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Todo List -->

    @if (Model.Todos != null &&
         Model.Todos.Count > 0)
    {
        <div class="row g-3">

            @foreach (var todo in Model.Todos)
            {
                <div class="col-12">

                    <div class="card shadow-sm
                        @(todo.IsCompleted ? "border-success" : "")">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <!-- Todo Information -->
                                <div class="col-md-7">

                                    <div class="d-flex align-items-center gap-2 mb-2">

                                        @if (todo.IsCompleted)
                                        {
                                            <h5 class="mb-0 text-decoration-line-through text-muted">
                                                @todo.Title
                                            </h5>
                                        }
                                        else
                                        {
                                            <h5 class="mb-0">
                                                @todo.Title
                                            </h5>
                                        }

                                        <!-- Status -->
                                        @if (todo.IsCompleted)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </div>

                                    <!-- Description -->
                                    @if (!string.IsNullOrWhiteSpace(todo.Description))
                                    {
                                        <p class="text-muted mb-2">
                                            @todo.Description
                                        </p>
                                    }

                                    <!-- Category -->
                                    @if (!string.IsNullOrWhiteSpace(todo.CategoryName))
                                    {
                                        <span class="badge bg-primary me-1">
                                            @todo.CategoryName
                                        </span>
                                    }

                                    <!-- Tags -->
                                    @if (todo.TagNames != null &&
                                         todo.TagNames.Count > 0)
                                    {
                                        @foreach (var tag in todo.TagNames)
                                        {
                                            <span class="badge bg-secondary me-1">
                                                #@tag
                                            </span>
                                        }
                                    }

                                </div>

                                <!-- Todo Metadata -->
                                <div class="col-md-2">

                                    <!-- Priority -->
                                    <div class="mb-2">

                                        <small class="text-muted d-block">
                                            Priority
                                        </small>

                                        @if (todo.Priority == "High")
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (todo.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">
                                                Low
                                            </span>
                                        }

                                    </div>

                                    <!-- Due Date -->
                                    <div>

                                        <small class="text-muted d-block">
                                            Due Date
                                        </small>

                                        @if (todo.DueDate.HasValue)
                                        {
                                            var isOverdue =
                                                !todo.IsCompleted &&
                                                todo.DueDate.Value.Date < DateTime.Today;

                                            if (isOverdue)
                                            {
                                                <span class="text-danger">
                                                    @todo.DueDate.Value.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @todo.DueDate.Value.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No due date
                                            </span>
                                        }

                                    </div>

                                </div>

                                <!-- Actions -->
                                <div class="col-md-3">

                                    <div class="d-flex flex-wrap gap-2 justify-content-md-end">

                                        <!-- Toggle Complete -->
                                        <form asp-action="ToggleComplete"
                                              asp-route-id="@todo.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            @if (todo.IsCompleted)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-warning">
                                                    Mark Pending
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Complete
                                                </button>
                                            }

                                        </form>

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-sm btn-primary">
                                            Edit
                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="DeleteConfirmation"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->

        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>
                    No Todos Found
                </h4>

                <p class="text-muted">
                    There are no todos matching your current filters.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Create Your First Todo
                </a>

            </div>

        </div>
    }

</div>