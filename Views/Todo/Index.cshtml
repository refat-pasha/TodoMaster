
@model IEnumerable<TodoMaster.Models.Todo>

@{
    ViewData["Title"] = "My Todos";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">My Todos</h1>
            <p class="text-muted mb-0">Manage your tasks and stay organized.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Todo
        </a>
    </div>


    <!-- Todo Statistics -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Total</p>
                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalCount
                            </h3>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="bi bi-list-task"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Pending -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Pending</p>
                            <h3 class="fw-bold mb-0">
                                @ViewBag.PendingCount
                            </h3>
                        </div>

                        <div class="fs-2 text-warning">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Completed -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Completed</p>
                            <h3 class="fw-bold mb-0">
                                @ViewBag.CompletedCount
                            </h3>
                        </div>

                        <div class="fs-2 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Overdue -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Overdue</p>
                            <h3 class="fw-bold mb-0">
                                @ViewBag.OverdueCount
                            </h3>
                        </div>

                        <div class="fs-2 text-danger">
                            <i class="bi bi-exclamation-circle"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form method="get" asp-action="Index">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by title or description..." />
                    </div>


                    <!-- Status -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status" class="form-select">

                            @if (string.IsNullOrEmpty(ViewBag.Status))
                            {
                                <option value="" selected>All</option>
                            }
                            else
                            {
                                <option value="">All</option>
                            }

                            @if (ViewBag.Status == "pending")
                            {
                                <option value="pending" selected>Pending</option>
                            }
                            else
                            {
                                <option value="pending">Pending</option>
                            }

                            @if (ViewBag.Status == "completed")
                            {
                                <option value="completed" selected>Completed</option>
                            }
                            else
                            {
                                <option value="completed">Completed</option>
                            }

                        </select>
                    </div>


                    <!-- Priority -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-semibold">
                            Priority
                        </label>

                        <select name="priority" class="form-select">

                            @if (ViewBag.Priority == null)
                            {
                                <option value="" selected>All</option>
                            }
                            else
                            {
                                <option value="">All</option>
                            }

                            @foreach (TodoMaster.Models.Priority priority
                                     in Enum.GetValues<TodoMaster.Models.Priority>())
                            {
                                if (ViewBag.Priority?.ToString() == priority.ToString())
                                {
                                    <option value="@priority" selected>
                                        @priority
                                    </option>
                                }
                                else
                                {
                                    <option value="@priority">
                                        @priority
                                    </option>
                                }
                            }

                        </select>
                    </div>


                    <!-- Sort -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-semibold">
                            Sort By
                        </label>

                        <select name="sort" class="form-select">

                            @if (string.IsNullOrEmpty(ViewBag.Sort))
                            {
                                <option value="" selected>Newest</option>
                            }
                            else
                            {
                                <option value="">Newest</option>
                            }

                            @if (ViewBag.Sort == "oldest")
                            {
                                <option value="oldest" selected>Oldest</option>
                            }
                            else
                            {
                                <option value="oldest">Oldest</option>
                            }

                            @if (ViewBag.Sort == "dueDate")
                            {
                                <option value="dueDate" selected>Due Date</option>
                            }
                            else
                            {
                                <option value="dueDate">Due Date</option>
                            }

                            @if (ViewBag.Sort == "priority")
                            {
                                <option value="priority" selected>Priority</option>
                            }
                            else
                            {
                                <option value="priority">Priority</option>
                            }

                        </select>
                    </div>


                    <!-- Buttons -->
                    <div class="col-lg-2 col-md-12 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Todo List -->

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-check2-circle display-4 text-muted"></i>
                </div>

                <h4>No todos found</h4>

                <p class="text-muted">
                    Try changing your search or filters.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Create Your First Todo
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var todo in Model)
            {
                var isOverdue = !todo.IsCompleted &&
                                todo.DueDate.HasValue &&
                                todo.DueDate.Value.Date < DateTime.Today;

                <div class="col-12">

                    <div class="card shadow-sm border-0
                                @(isOverdue ? "border-start border-4 border-danger" : "")">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <!-- Complete / Undo -->
                                <div class="col-auto">

                                    <form asp-action="Complete"
                                          asp-route-id="@todo.Id"
                                          method="post"
                                          class="d-inline">

                                        @if (todo.IsCompleted)
                                        {
                                            <button type="submit"
                                                    class="btn btn-success rounded-circle"
                                                    title="Mark as pending">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-outline-secondary rounded-circle"
                                                    title="Mark as completed">
                                                <i class="bi bi-circle"></i>
                                            </button>
                                        }

                                    </form>

                                </div>


                                <!-- Todo Information -->
                                <div class="col">

                                    <!-- Title -->
                                    @if (todo.IsCompleted)
                                    {
                                        <h5 class="mb-1 text-decoration-line-through text-muted">
                                            @todo.Title
                                        </h5>
                                    }
                                    else if (isOverdue)
                                    {
                                        <h5 class="mb-1 text-danger fw-semibold">
                                            @todo.Title
                                        </h5>
                                    }
                                    else
                                    {
                                        <h5 class="mb-1">
                                            @todo.Title
                                        </h5>
                                    }


                                    <!-- Description -->
                                    @if (!string.IsNullOrWhiteSpace(todo.Description))
                                    {
                                        <p class="text-muted mb-2">
                                            @todo.Description
                                        </p>
                                    }


                                    <!-- Metadata -->
                                    <div class="d-flex flex-wrap gap-2">

                                        <!-- Priority -->
                                        @switch (todo.Priority.ToString())
                                        {
                                            case "High":
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-flag-fill"></i>
                                                    High
                                                </span>
                                                break;

                                            case "Medium":
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-flag-fill"></i>
                                                    Medium
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-success">
                                                    <i class="bi bi-flag"></i>
                                                    @todo.Priority
                                                </span>
                                                break;
                                        }


                                        <!-- Due Date -->
                                        @if (todo.DueDate.HasValue)
                                        {
                                            @if (isOverdue)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-exclamation-triangle"></i>
                                                    Overdue:
                                                    @todo.DueDate.Value.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">
                                                    <i class="bi bi-calendar3"></i>
                                                    @todo.DueDate.Value.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                        }


                                        <!-- Status -->
                                        @if (todo.IsCompleted)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i>
                                                Completed
                                            </span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-circle"></i>
                                                Overdue
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split"></i>
                                                Pending
                                            </span>
                                        }

                                    </div>

                                </div>


                                <!-- Actions -->
                                <div class="col-auto">

                                    <div class="btn-group">

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@todo.Id"
                                           class="btn btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>


                                        <!-- Delete -->
                                        <form asp-action="Delete"
                                              asp-route-id="@todo.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this todo?');">

                                            <button type="submit"
                                                    class="btn btn-outline-danger"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

