@using TodoMaster.Models
@model TodoMaster.Models.Todo

@{
    ViewData["Title"] = "Todo Details";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Todo Details</h1>
            <p class="text-muted mb-0">
                View complete information about this task.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Todo"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-controller="Todo"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>


    <!-- Todo Details -->
    <div class="card shadow-sm border-0">

        <!-- Title -->
        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <h2 class="fw-bold mb-2">
                        @Model.Title
                    </h2>

                    @if (Model.IsCompleted)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-clock me-1"></i>
                            Pending
                        </span>
                    }

                </div>


                <!-- Priority -->
                <div>

                    @if (Model.Priority == Priority.High)
                    {
                        <span class="badge bg-danger fs-6">
                            High Priority
                        </span>
                    }
                    else if (Model.Priority == Priority.Medium)
                    {
                        <span class="badge bg-warning text-dark fs-6">
                            Medium Priority
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6">
                            Low Priority
                        </span>
                    }

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            <!-- Description -->
            <div class="mb-4">

                <h5 class="fw-bold mb-2">
                    Description
                </h5>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-0"
                       style="white-space: pre-line;">
                        @Model.Description
                    </p>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">
                        No description provided.
                    </p>
                }

            </div>


            <hr />


            <!-- Information -->
            <div class="row g-4 mt-1">

                <!-- Category -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <div class="me-3 fs-4 text-primary">
                            <i class="bi bi-folder"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Category
                            </small>

                            @if (Model.Category != null)
                            {
                                <span class="fw-semibold">
                                    @Model.Category.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No category
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Due Date -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <div class="me-3 fs-4 text-primary">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Due Date
                            </small>

                            @if (Model.DueDate.HasValue)
                            {
                                var isOverdue =
                                    !Model.IsCompleted &&
                                    Model.DueDate.Value.Date < DateTime.Today;

                                if (isOverdue)
                                {
                                    <span class="fw-semibold text-danger">
                                        @Model.DueDate.Value.ToString("dd MMM yyyy")
                                        <small>(Overdue)</small>
                                    </span>
                                }
                                else if (Model.DueDate.Value.Date == DateTime.Today)
                                {
                                    <span class="fw-semibold text-warning">
                                        Today
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-semibold">
                                        @Model.DueDate.Value.ToString("dd MMM yyyy")
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    No due date
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <div class="me-3 fs-4 text-primary">
                            <i class="bi bi-check2-square"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Status
                            </small>

                            @if (Model.IsCompleted)
                            {
                                <span class="fw-semibold text-success">
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="fw-semibold text-warning">
                                    Pending
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Priority -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <div class="me-3 fs-4 text-primary">
                            <i class="bi bi-flag"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Priority
                            </small>

                            @if (Model.Priority == Priority.High)
                            {
                                <span class="fw-semibold text-danger">
                                    High
                                </span>
                            }
                            else if (Model.Priority == Priority.Medium)
                            {
                                <span class="fw-semibold text-warning">
                                    Medium
                                </span>
                            }
                            else
                            {
                                <span class="fw-semibold text-success">
                                    Low
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Tags -->
            <div>

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-tags me-1"></i>
                    Tags
                </h5>

                @if (Model.Tags != null && Model.Tags.Any())
                {
                    <div class="d-flex flex-wrap gap-2">

                        @foreach (var tag in Model.Tags)
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-tag me-1"></i>
                                @tag.Name
                            </span>
                        }

                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No tags assigned.
                    </p>
                }

            </div>

        </div>


        <!-- Footer -->
        <!-- Footer -->
<div class="card-footer bg-white border-0 p-4">
    <div class="d-flex justify-content-between align-items-center">

        <form asp-controller="Todo"
              asp-action="Delete"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this todo?');">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-outline-danger">

                <i class="bi bi-trash me-1"></i>
                Delete

            </button>

        </form>

        <a asp-controller="Todo"
           asp-action="Index"
           class="btn btn-secondary">

            Back to Todos

        </a>

    </div>
</div>

    </div>

</div>