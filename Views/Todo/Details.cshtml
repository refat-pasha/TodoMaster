@model TodoMaster.ViewModels.TodoViewModel

@{
    ViewData["Title"] = "Todo Details";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Todo Details</h2>
            <p class="text-muted mb-0">
                View the complete information of this todo.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>

    <!-- Todo Details -->
    <div class="card shadow-sm">

        <div class="card-body">

            <!-- Title and Status -->
            <div class="mb-4">

                <div class="d-flex align-items-center gap-2">

                    <h3 class="mb-0">
                        @Model.Title
                    </h3>

                    @if (Model.IsCompleted)
                    {
                        <span class="badge bg-success">
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }

                </div>

            </div>

            <hr />

            <!-- Description -->
            <div class="mb-4">

                <h5>Description</h5>

                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted">
                        No description provided.
                    </p>
                }
                else
                {
                    <p class="mb-0">
                        @Model.Description
                    </p>
                }

            </div>

            <!-- Information -->
            <div class="row mb-4">

                <!-- Priority -->
                <div class="col-md-4 mb-3">

                    <strong>Priority</strong>

                    <div class="mt-2">

                        @if (Model.Priority == "High")
                        {
                            <span class="badge bg-danger">
                                High
                            </span>
                        }
                        else if (Model.Priority == "Medium")
                        {
                            <span class="badge bg-warning text-dark">
                                Medium
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">
                                Low
                            </span>
                        }

                    </div>

                </div>

                <!-- Category -->
                <div class="col-md-4 mb-3">

                    <strong>Category</strong>

                    <div class="mt-2">

                        @if (string.IsNullOrWhiteSpace(Model.CategoryName))
                        {
                            <span class="text-muted">
                                No Category
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary">
                                @Model.CategoryName
                            </span>
                        }

                    </div>

                </div>

                <!-- Due Date -->
                <div class="col-md-4 mb-3">

                    <strong>Due Date</strong>

                    <div class="mt-2">

                        @if (Model.DueDate.HasValue)
                        {
                            var isOverdue =
                                !Model.IsCompleted &&
                                Model.DueDate.Value.Date < DateTime.Today;

                            if (isOverdue)
                            {
                                <span class="text-danger fw-bold">
                                    @Model.DueDate.Value.ToString("dd MMM yyyy")
                                    (Overdue)
                                </span>
                            }
                            else
                            {
                                <span>
                                    @Model.DueDate.Value.ToString("dd MMM yyyy")
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                No due date
                            </span>
                        }

                    </div>

                </div>

            </div>

            <!-- Tags -->
            <div class="mb-4">

                <h5>Tags</h5>

                @if (Model.TagNames != null &&
                     Model.TagNames.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2">

                        @foreach (var tag in Model.TagNames)
                        {
                            <span class="badge bg-secondary">
                                #@tag
                            </span>
                        }

                    </div>
                }
                else
                {
                    <p class="text-muted">
                        No tags assigned.
                    </p>
                }

            </div>

            <!-- Created Date -->
            <div class="mb-4">

                <strong>Created At</strong>

                <p class="text-muted mb-0">
                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                </p>

            </div>

            <hr />

            <!-- Actions -->
            <div class="d-flex flex-wrap gap-2">

                <!-- Edit -->
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit
                </a>

                <!-- Toggle Complete -->
                <form asp-action="ToggleComplete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    @if (Model.IsCompleted)
                    {
                        <button type="submit"
                                class="btn btn-warning">
                            Mark as Pending
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-success">
                            Mark as Completed
                        </button>
                    }

                </form>

                <!-- Delete -->
                <a asp-action="DeleteConfirmation"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger">
                    Delete
                </a>

                <!-- Back -->
                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to List
                </a>

            </div>

        </div>

    </div>

</div>