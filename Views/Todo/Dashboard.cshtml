@{
    ViewData["Title"] = "Todo Dashboard";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 me-2"></i>
                Todo Dashboard
            </h2>

            <p class="text-muted mb-0">
                Overview of your tasks and progress.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Todo"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                New Todo

            </a>

            <a asp-controller="Todo"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-list-task me-1"></i>
                All Todos

            </a>

        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Total -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Total Todos
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalTodos
                            </h2>
                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-list-check"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Completed
                            </p>

                            <h2 class="fw-bold text-success mb-0">
                                @ViewBag.CompletedTodos
                            </h2>
                        </div>

                        <div class="fs-1 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Pending
                            </p>

                            <h2 class="fw-bold text-warning mb-0">
                                @ViewBag.PendingTodos
                            </h2>
                        </div>

                        <div class="fs-1 text-warning">
                            <i class="bi bi-clock"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Overdue -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Overdue
                            </p>

                            <h2 class="fw-bold text-danger mb-0">
                                @ViewBag.OverdueTodos
                            </h2>
                        </div>

                        <div class="fs-1 text-danger">
                            <i class="bi bi-exclamation-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Today's Tasks -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-calendar-day me-2"></i>
                        Today's Tasks
                    </h5>

                    <p class="text-muted mb-0">
                        Incomplete tasks due today.
                    </p>

                </div>

                <span class="badge bg-primary fs-6">
                    @ViewBag.TodayTodos
                </span>

            </div>

        </div>

    </div>

    <!-- Completion Progress -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-bar-chart me-2"></i>
                Completion Progress
            </h5>

            @{
                var total = (int)ViewBag.TotalTodos;
                var completed = (int)ViewBag.CompletedTodos;

                var progress = total > 0
                    ? (completed * 100 / total)
                    : 0;
            }

            <span class="fw-semibold">
                @progress%
            </span>

        </div>

        <div class="progress"
             role="progressbar"
             aria-valuenow="@progress"
             aria-valuemin="0"
             aria-valuemax="100"
             style="height: 12px;">

            <div class="progress-bar"
                 style="width: @progress%;">
            </div>

        </div>

        <small class="text-muted d-block mt-2">
            @completed of @total todos completed
        </small>

    </div>

</div>


    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Quick Actions
            </h5>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Todo"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Create Todo

                </a>

                <a asp-controller="Todo"
                   asp-action="Index"
                   class="btn btn-outline-primary">

                    <i class="bi bi-list-task me-1"></i>
                    View Todos

                </a>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-folder me-1"></i>
                    Categories

                </a>

                <a asp-controller="Tag"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-tags me-1"></i>
                    Tags

                </a>

            </div>

        </div>

    </div>

</div>